# Port Configuration
PORT=5000

# Database Configuration
# Replace with your actual local or remote Atlas MongoDB URI if needed
MONGO_URI=mongodb+srv://admin:yourpassword@your-cluster.mongodb.net/your-db?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development

# Exchange Rate API Key (V6)
EXCHANGE_RATE_API_KEY=

# AWS Amazon Bedrock Configuration
# Set these variables to enable live Claude 3 AI risk analysis reports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
